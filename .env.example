# Copy to .env.local. Only the Supabase block is required; every other service falls back to
# its mock when the key is missing, and the UI then shows a "demo-modus" badge.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI & voice (phase 2) ---
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Book & payments (phase 3) ---
PEECHO_API_KEY=
MOLLIE_API_KEY=
WORKER_URL=

# --- Messaging & video ---
POSTMARK_TOKEN=
WHATSAPP_TOKEN=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# --- Observability (optional) ---
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
